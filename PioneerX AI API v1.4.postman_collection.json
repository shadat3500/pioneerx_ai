    {
      "name": "Conversations",
      "description": "v1.4 section-scoped chatbot. Replaces the old single-prompt generate flow.",
      "item": [
        {
          "name": "Get or Create Conversation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{url}}/conversations/{{section_key}}",
              "host": ["{{url}}"],
              "path": ["conversations", "{{section_key}}"]
            },
            "description": "Finds conversation for { userId, activeProfileId, section }. Creates one if missing.\nReturns conversation + all messages ordered by createdAt ASC."
          },
          "response": []
        },
        {
          "name": "Send Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.message) {",
                  "    console.log('Assistant:', jsonData.data.message.content);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"content\": \"How should I structure my marketing budget for the first 3 months?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{url}}/conversations/{{section_key}}/message",
              "host": ["{{url}}"],
              "path": ["conversations", "{{section_key}}", "message"]
            },
            "description": "Saves user message, calls AI with last 10 messages as context, saves assistant reply.\n\nBody: { content: string }\n\nReturns: { message, tokenStatus }"
          },
          "response": []
        },
        {
          "name": "Generate Action Steps + Links",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.generationId) {",
                  "    pm.collectionVariables.set(\"generation_id\", jsonData.data.generationId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{url}}/conversations/{{section_key}}/generate",
              "host": ["{{url}}"],
              "path": ["conversations", "{{section_key}}", "generate"]
            },
            "description": "Triggered by the Generate button. Uses last 10 conversation messages.\nNo body required.\n\nReturns: { generationId, action_steps[4], suggested_links[4], tokenStatus }\n\nAuto-saves generation_id to collection variable for Save Output."
          },
          "response": []
        }
      ]
