  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "🔗 Magic Link — Request",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"pogici5531@epaynine.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{url}}/auth/magic-link",
              "host": ["{{url}}"],
              "path": ["auth", "magic-link"]
            },
            "description": "Sends a magic link login email. If user does not exist, creates account with 3-day trial. Always returns { message: 'Check your email' }."
          },
          "response": []
        },
        {
          "name": "🔗 Magic Link — Verify Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.access_token) {",
                  "    pm.environment.set(\"access_token\", jsonData.data.access_token);",
                  "    pm.environment.set(\"refresh_token\", jsonData.data.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{url}}/auth/verify?token={{magic_link_token}}",
              "host": ["{{url}}"],
              "path": ["auth", "verify"],
              "query": [
                {
                  "key": "token",
                  "value": "{{magic_link_token}}",
                  "description": "The token received in the magic link email"
                }
              ]
            },
            "description": "Verifies magic link token and issues JWT access + refresh tokens. Token expires in 15 minutes and is single-use."
          },
          "response": []
        },
        {
          "name": "Google OAuth — Initiate",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{url}}/auth/google",
              "host": ["{{url}}"],
              "path": ["auth", "google"]
            },
            "description": "Redirects the user to Google OAuth consent screen. Open this in a browser, not Postman."
          },
          "response": []
        }
      ]
    },
