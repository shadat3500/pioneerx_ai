# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# JWT
JWT_AT_SECRET=at-secret
JWT_RT_SECRET=rt-secret
JWT_AT_EXPIRES_IN=7d
JWT_RT_EXPIRES_IN=7d

# Mail
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=user
MAIL_PASS=pass
MAIL_FROM="NestJS Template <noreply@example.com>"

# Redis configuration
REDIS_URL=redis://localhost:6379

# Crypto / Encryption Key (32-byte hex for AES-256)
ENCRYPTION_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08

# RevenueCat Integration
REVENUECAT_SECRET_KEY=your-revenuecat-webhook-secret

# Shopify App Integration
SHOPIFY_API_KEY=your-shopify-app-api-key
SHOPIFY_API_SECRET=your-shopify-app-secret-key

# AI Provider API Keys
OPENAI_API_KEY=your-openai-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key
XAI_API_KEY=your-xai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://yourapp.com/api/v1/auth/google/callback

# Apple Sign In
APPLE_CLIENT_ID=your-apple-services-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Frontend URL (used for magic link verification email + Stripe URL fallbacks)
FRONTEND_URL=https://yourapp.com

# Extra CORS origins (comma-separated). Prod allowlist = FRONTEND_URL + these.
# Example: https://admin.yourdomain.com,https://yourdomain.com
CORS_ORIGINS=

# Full AWS / Google / Stripe / Redis notes: ../DEPLOY_CHECKLIST.md

